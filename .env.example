# =============================================================================
# OmniDiag — Environment Variables
# =============================================================================
# Copy this file to .env and update values for your local environment.
#
#   cp .env.example .env
#
# For local development without Docker/PostgreSQL, the SQLite fallback is used
# automatically (no .env changes needed).
# =============================================================================

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (used when running with docker-compose).
DATABASE_URL=postgresql+asyncpg://omnidiag:omnidiag_pass@localhost:5432/omnidiag_db

# For local development without PostgreSQL (SQLite fallback — works out of the box):
# DATABASE_URL=sqlite+aiosqlite:///./omnidiag_dev.db

# ── Security (used by JWT in Feature 2.2) ──────────────────────────────────
# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS middleware.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
